    },
    "Press %@ to search apps, type “snip” for snippets and “tr” to translate.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 %@ 搜索 App，输入“snip”查找片段，输入“tr”进行翻译。"
