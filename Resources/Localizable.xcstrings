{
  "sourceLanguage": "en",
  "strings": {
    "%@ · ⏎ to copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ⏎ 复制"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · ⏎ でコピー"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        }
      }
    },
    "AetherSeek": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherSeek"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherSeek"
          }
        }
      }
    },
    "AetherSeek Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherSeek 设置"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherSeek 設定"
          }
        }
      }
    },
    "AetherSeek needs Accessibility access to expand snippets as you type and to paste into other apps. Nothing you type leaves your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AetherSeek 需要“辅助功能”权限，才能在你输入时展开片段并粘贴到其他 App。你输入的内容不会离开这台 Mac。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力中にスニペットを展開したり、ほかのアプリへペーストしたりするには、アクセシビリティへのアクセスが必要です。入力内容がこの Mac の外へ送られることはありません。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose Alfred.alfredpreferences": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Alfred.alfredpreferences"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Alfred.alfredpreferences を選択"
          }
        }
      }
    },
    "Content": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容"
          }
        }
      }
    },
    "Couldn’t detect the language": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别语言"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語を判別できません"
          }
        }
      }
    },
    "Create a group or import from Alfred.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建分组，或从 Alfred 导入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループを作成するか、Alfred から読み込んでください。"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Delete “%@” and its %lld snippets?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete “%1$@” and its %2$lld snippets?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%1$@”及其中的 %2$lld 个片段？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”とその %2$lld 個のスニペットを削除しますか？"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        }
      }
    },
